# ============================================
# GYM SMARTH — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# DATABASE: Connection string para PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgresql://postgres:abc123@localhost:5432/gymsmarth"

# AUTH: Chave secreta para assinatura JWT
JWT_SECRET="gymsmarth_super_secret_key_2024"

# Configurações de E-mail (Google / Gmail)
# Para Gmail, use uma Senha de App (App Password). 
# Não use sua senha normal.
EMAIL_USER="seu-email@gmail.com"
EMAIL_PASS="sua-senha-de-app"

# OPENROUTER_API_KEY: Chave da API do OpenRouter para análise de exames por IA
# Crie uma conta em https://openrouter.ai/keys para gerar uma chave
OPENROUTER_API_KEY="84bf94551619c51b3b2a137a51d75201deca1f4cc12daddb509d65ad3d7f17fe"

# AI_MODEL: Modelo de IA usado pelo OpenRouter
# Opções gratuitas: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
AI_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"

# APP_URL: URL base do servidor
APP_URL="http://localhost:3000"
