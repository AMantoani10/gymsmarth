# ============================================
# GYM SMARTH — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha os valores

# DATABASE: Connection string para PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/gymsmarth"

# AUTH: Chave secreta para assinatura JWT
JWT_SECRET="gym_smarth_secret_2024"

# OPENROUTER_API_KEY: Chave da API do OpenRouter para análise de exames por IA
# Crie uma conta em https://openrouter.ai/keys para gerar uma chave
OPENROUTER_API_KEY="sua_chave_openrouter_aqui"

# AI_MODEL: Modelo de IA usado pelo OpenRouter
# Opções gratuitas: nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
AI_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"

# APP_URL: URL base do servidor
APP_URL="http://localhost:3000"
